# ==============================================================================
# AETHERX PRO CRM — ENVIRONMENT CONFIGURATION
# StartAppGuru (1 Admin + 3 Callers)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Supabase / PostgreSQL)
# ------------------------------------------------------------------------------
# Optional for local development (uses local persistent JSON if omitted).
# REQUIRED for production cloud deployment on Vercel with persistent data:
# Obtain this from Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Or transaction pooler URL (port 6543) for serverless environments:
# POSTGRES_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# ------------------------------------------------------------------------------
# 2. SUPABASE STORAGE (Call Recordings & Lead Attachments)
# ------------------------------------------------------------------------------
# Used to store and play back telephony MP3/WAV call recordings and lead documents:
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_RECORDINGS_BUCKET=call-recordings

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SESSION SECURITY
# ------------------------------------------------------------------------------
# 32+ character random secret used to sign HMAC session tokens:
AUTH_SECRET=aetherx-super-secure-production-secret-replace-in-prod-2026

# ------------------------------------------------------------------------------
# 4. CLOUD TELEPHONY INTEGRATION (Exotel / Twilio / Ozonetel)
# ------------------------------------------------------------------------------
# Select active provider: exotel | twilio | ozonetel | knowlarity
TELEPHONY_PROVIDER=exotel
TELEPHONY_ACCOUNT_SID=your_exotel_sid_or_twilio_sid
TELEPHONY_API_KEY=your_telephony_api_key
TELEPHONY_API_TOKEN=your_telephony_api_token
TELEPHONY_CALLER_ID=+912249128800
# Webhook URL to register in provider console:
# https://[your-domain].vercel.app/api/webhooks/calls
TELEPHONY_WEBHOOK_SECRET=your_webhook_validation_token

# ------------------------------------------------------------------------------
# 5. DEFAULT SEED ACCOUNTS (Created automatically on initial deploy)
# ------------------------------------------------------------------------------
# Password for all initial accounts: admin@aetherx
# Workspace Admin: admin@aetherx.app / admin@aetherx
# Caller 1:        caller1@aetherx.app / admin@aetherx
# Caller 2:        caller2@aetherx.app / admin@aetherx
# Caller 3:        caller3@aetherx.app / admin@aetherx
# Platform Owner:  superadmin@aetherx.app / admin@aetherx
